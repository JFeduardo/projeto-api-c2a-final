# Copie este arquivo para ".env" e preencha os valores reais.
# cp .env.example .env

# ---- Credenciais NDD Print ----
NDD_DEALER_NAME=
# OBRIGATORIO pela API, mesmo que nao tenha vindo no material original:
NDD_DEALER_USER_EMAIL=
# Senha ja criptografada (AES-256-CBC + Base64), conforme fornecida pela NDD:
NDD_DEALER_PASSWORD=

# ---- WSDLs (mude o host se seu provedor for de outra regiao) ----
NDD_GENERAL_WSDL=
NDD_COUNTERS_WSDL=
NDD_EVENTS_WSDL=

SOAP_TIMEOUT_SECONDS=30

# ---- Polling ----
# A cada quantos segundos o backend busca dados novos na API do NDD
POLL_INTERVAL_SECONDS=1800
# Impressora e considerada offline se nao tiver leitura de contador ha
# mais que N minutos
PRINTER_OFFLINE_THRESHOLD_MINUTES=30
